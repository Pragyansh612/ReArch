<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <description>Order, billing and party service definitions</description>

    <service name="createOrder" engine="java"
             location="com.example.legacy.order.OrderServices" invoke="createOrder" auth="true">
        <description>Create an order header</description>
        <attribute name="orderId" type="String" mode="IN"/>
    </service>

    <service name="cancelOrder" engine="java"
             location="com.example.legacy.order.OrderServices" invoke="cancelOrder" auth="true">
        <attribute name="orderId" type="String" mode="IN"/>
    </service>

    <service name="createInvoice" engine="java"
             location="com.example.legacy.billing.InvoiceService" invoke="createInvoice" auth="true">
        <attribute name="orderId" type="String" mode="IN"/>
    </service>

    <service name="findParty" engine="java"
             location="com.example.legacy.party.PartyService" invoke="findParty" auth="false">
        <attribute name="partyId" type="String" mode="IN"/>
    </service>

    <service name="checkOrderFraud" engine="groovy"
             location="component://legacy/src/main/groovy/com/example/legacy/order/CheckOrderFraud.groovy"
             invoke="" auth="true">
        <attribute name="orderId" type="String" mode="IN"/>
    </service>

    <!-- Logic that is not Java: counted in coverage, never analysed. -->
    <service name="calculateShippingQuote" engine="simple"
             location="component://legacy/minilang/ShippingServices.xml" invoke="calculateShippingQuote"/>
    <service name="recalculateTotals" engine="simple"
             location="component://legacy/minilang/OrderTotals.xml" invoke="recalculateTotals"/>
    <service name="createOrderNote" engine="entity-auto" default-entity-name="OrderNote" invoke="create"/>
    <service name="updateOrderNote" engine="entity-auto" default-entity-name="OrderNote" invoke="update"/>
    <service name="deleteOrderNote" engine="entity-auto" default-entity-name="OrderNote" invoke="delete"/>
    <service name="orderInterface" engine="interface" location="" invoke=""/>

    <!-- Dangling definitions: the three reference outcomes a broken-reference check must tell apart. -->
    <service name="findPartyByEmail" engine="java"
             location="com.example.legacy.party.PartyService" invoke="findPartyByEmail" auth="false">
        <description>Class exists, method does not (method_missing)</description>
    </service>
    <service name="runGhostInvoicer" engine="java"
             location="com.example.legacy.billing.GhostInvoicer" invoke="run" auth="true">
        <description>Class missing from an analysed module (class_missing)</description>
    </service>
    <service name="syncExternalLedger" engine="java"
             location="org.other.legacy.Elsewhere" invoke="run" auth="true">
        <description>Class lives in a module we did not analyse (out_of_scope, NOT broken)</description>
    </service>
</services>
