  "deliberate_smells": [
    {
      "smell": "god_class",
      "why": "OrderServices holds every order workflow in one ~800-line class with 16 near-identical workflow methods. Stands in for OFBiz OrderServices.java (7,516 LOC). Also in a module with no tests. LedgerReconciler (LOC 400, complexity 51) sits exactly on the thresholds and MUST be flagged; StatementFormatter (LOC 399, complexity 50) sits one short of both and must NOT be.",
      "subjects": [
        "LedgerReconciler",
        "OrderServices"
      ]
    },
    {
      "smell": "highly_coupled_service",
      "why": "OrderReadHelper is used by party, billing and order (fan-in) and itself reaches into party and billing (fan-out), creating module cycles order<->party and order<->billing. Stands in for OFBiz OrderReadHelper/ShoppingCart-style hubs.",
      "subjects": [
        "OrderReadHelper"
      ]
    },
    {
      "smell": "db_coupling_jdbc",
      "why": "Raw Connection/PreparedStatement and SQL strings inside billing business logic. Stands in for hand-written JDBC in OFBiz helpers and pre-entity-engine code.",
      "subjects": [
        "InvoiceService"
      ]
    },
    {
      "smell": "db_coupling_entity_engine",
      "why": "Business logic calls EntityQuery/delegator directly instead of through a repository layer. This is the dominant OFBiz pattern (hundreds of EntityQuery calls in applications/order).",
      "subjects": [
        "OrderReadHelper",
        "OrderServices",
        "PartyService"
      ]
    },
    {
      "smell": "no_tests",
      "why": "order (the riskiest module) and common have no tests. Stands in for OFBiz order/product/party/accounting having zero unit tests.",
      "subjects": [
        "common",
        "order"
      ]
    },
    {
      "smell": "namespace_mix",
      "why": "party has PartyController on jakarta.servlet and PartyLegacyHelper on javax.servlet, mirroring OFBiz's mid-migration (139 javax vs 272 jakarta files).",
      "subjects": [
        "party"
      ]
    },
    {
      "smell": "legacy_ejb",
      "why": "javax.ejb.Stateless import marks EJB-era design.",
      "subjects": [
        "OrderServices"
      ]
    },
    {
      "smell": "logic_outside_java",
      "why": "Service definitions and a Groovy script carry behavior the Java analyzer cannot see; must be counted and reported as not analyzed.",
      "subjects": [
        "services.xml",
        "CheckOrderFraud.groovy"
      ]
    }
  ],
